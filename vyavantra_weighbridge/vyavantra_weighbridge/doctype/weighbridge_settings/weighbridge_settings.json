   "fieldtype": "Column Break"
  },
  {
   "fieldname": "report_address",
   "fieldtype": "Small Text",
   "label": "Address"
  },
  {
   "fieldname": "indicator_source",
   "fieldtype": "Select",
   "label": "Read weight from",
   "options": "Server\nBrowser Serial Port\nWeighbridge Service",
   "default": "Server",
   "description": "Server: the server reads the indicator (URL below or its own COM port). Browser Serial Port: the Chrome / Edge of the weighbridge PC reads its COM port. Weighbridge Service: the browser asks the WeighbridgeService running on the weighbridge PC"
  },
  {
   "fieldname": "indicator_service_url",
   "fieldtype": "Data",
   "label": "Weighbridge Service URL (fallback)",
   "depends_on": "eval:doc.indicator_source=='Weighbridge Service'",
   "description": "Leave empty for the normal setup. http://127.0.0.1:8765/weight/stable is always tried first; this address is used only when the service does not answer there, e.g. another port or another PC"
  },
  {
   "fieldname": "indicator_service_timeout",
   "fieldtype": "Int",
   "label": "Stable Weight Wait (ms)",
   "default": "15000",
   "depends_on": "eval:doc.indicator_source=='Weighbridge Service'",
   "description": "How long the service may wait for the scale to settle before it gives up"
  },
  {
   "fieldname": "indicator_parity",
   "fieldtype": "Select",
   "label": "Parity",
   "options": "none\neven\nodd",
   "default": "none",
   "depends_on": "eval:doc.indicator_source=='Browser Serial Port'"
  },
  {
   "fieldname": "indicator_data_bits",
   "fieldtype": "Select",
   "label": "Data Bits",
   "options": "8\n7",
   "default": "8",
   "depends_on": "eval:doc.indicator_source=='Browser Serial Port'"
  },
  {
   "fieldname": "indicator_stop_bits",
   "fieldtype": "Select",
   "label": "Stop Bits",
   "options": "1\n2",
   "default": "1",
   "depends_on": "eval:doc.indicator_source=='Browser Serial Port'"
  },
  {
   "fieldname": "indicator_stable_readings",
   "fieldtype": "Int",
   "label": "Stable Readings",
   "default": "3",
   "depends_on": "eval:doc.indicator_source=='Browser Serial Port'",
   "description": "The weight is taken when the indicator sends this many identical readings in a row"
  },
