  {
   "fieldname": "indicator_url",
   "fieldtype": "Data",
   "label": "Indicator HTTP URL",
   "description": "URL returning the current weight as text/JSON (e.g. a serial-to-HTTP gateway)",
   "depends_on": "eval:!doc.indicator_source || doc.indicator_source=='Server'"
  },
  {
   "fieldname": "cb_16",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "indicator_serial_port",
   "fieldtype": "Data",
   "label": "Indicator Serial Port",
   "description": "e.g. COM3 or /dev/ttyUSB0 (needs pyserial on the server)",
   "depends_on": "eval:!doc.indicator_source || doc.indicator_source=='Server'"
  },
  {
   "fieldname": "indicator_baud_rate",
   "fieldtype": "Int",
   "label": "Indicator Baud Rate",
   "default": "9600",
   "description": "Speed of the serial line, same as set on the indicator. Not used by the Weighbridge Service, which reads the COM port itself",
   "depends_on": "eval:!doc.indicator_source || doc.indicator_source!='Weighbridge Service'"
  },
