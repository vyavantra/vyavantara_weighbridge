 "html": "{#- Print format \"Diesel Issue Slip\" for Diesel Issue Entry. Layout follows the client's paper diesel slip pad. -#}\n{%- set pump = frappe.db.get_value(\"Petrol Pump\", doc.petrol_pump_name, \"petrol_pump_name\") if doc.petrol_pump_name else \"\" -%}\n{%- set receiver = frappe.db.get_value(\"Diesel Receiver\", doc.disel_receiver_name, \"disel_receiver_name\") if doc.disel_receiver_name else \"\" -%}\n{%- set vehicle = frappe.db.get_value(\"Tractor Number\", doc.tractor_number, \"tractor_number\") if doc.tractor_number else \"\" -%}\n{%- set qty = doc.disel_qty or 0 -%}\n<style>\n\t@font-face { font-family: \"SlipDeva\"; font-weight: normal; src: url(\"/assets/vyavantra_weighbridge/fonts/NotoSansDevanagari-Regular.ttf\") format(\"truetype\"); }\n\t@font-face { font-family: \"SlipDeva\"; font-weight: bold; src: url(\"/assets/vyavantra_weighbridge/fonts/NotoSansDevanagari-Bold.ttf\") format(\"truetype\"); }\n\t.slip, .slip td, .slip div { font-family: \"SlipDeva\", \"Noto Sans Devanagari\", sans-serif; color: #111; }\n\t.slip { padding: 6px 4px 4px 4px; font-size: 14px; line-height: 1.5; }\n\t.slip table { width: 100%; border-collapse: collapse; }\n\t.slip td { vertical-align: bottom; padding: 0; }\n\t.slip .logo { width: 210px; height: auto; }\n\t.slip .addr { font-size: 11px; text-align: right; color: #333; line-height: 1.35; }\n\t.slip .rule { border-top: 1.5px solid #0b2a5b; margin: 8px 0 10px 0; }\n\t.slip .lbl { white-space: nowrap; padding-right: 8px; }\n\t.slip .fill { border-bottom: 1px solid #333; font-weight: bold; padding: 0 6px; height: 28px; }\n\t.slip .end { white-space: nowrap; padding-left: 8px; width: 1%; }\n\t.slip .no { color: #c0121f; font-weight: bold; font-size: 16px; }\n\t.slip .sign td { text-align: center; padding-top: 52px; }\n\t.slip .sign .cap { border-top: 1px solid #333; width: 70%; display: inline-block; padding-top: 2px; font-size: 13px; }\n</style>\n\n<div class=\"slip\">\n\t<table>\n\t\t<tr>\n\t\t\t<td style=\"width:45%\"><img class=\"logo\" src=\"/assets/vyavantra_weighbridge/images/rajdatt_logo.png\"></td>\n\t\t\t<td class=\"addr\">\n\t\t\t\tGat No: 584, At/Post Apshinge<br>\n\t\t\t\tTal: Koregaon, Dist: Satara - 415511<br>\n\t\t\t\tMaharashtra, India\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\t<div class=\"rule\"></div>\n\n\t<table>\n\t\t<tr>\n\t\t\t<td class=\"lbl\" style=\"width:1%\">No.</td>\n\t\t\t<td class=\"no\">{{ doc.name }}</td>\n\t\t\t<td class=\"lbl\" style=\"text-align:right\">\u0924\u093e.</td>\n\t\t\t<td class=\"fill\" style=\"width:30%; text-align:center\">{{ frappe.utils.formatdate(doc.issue_date, \"dd/MM/yyyy\") if doc.issue_date else \"\" }}</td>\n\t\t</tr>\n\t</table>\n\n\t<table>\n\t\t<tr>\n\t\t\t<td class=\"lbl\">\u092e\u0947\u0938\u0930\u094d\u0938</td>\n\t\t\t<td class=\"fill\">{{ pump }}</td>\n\t\t\t<td class=\"end\">&nbsp;</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"lbl\">&nbsp;</td>\n\t\t\t<td class=\"fill\">{{ receiver }}</td>\n\t\t\t<td class=\"end\">\u092f\u093e\u0902\u0928\u093e</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"lbl\">\u0935\u093e\u0939\u0928 \u0928\u0902\u092c\u0930</td>\n\t\t\t<td class=\"fill\">{{ vehicle }}</td>\n\t\t\t<td class=\"end\">\u092f\u093e\u0902\u0938</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"lbl\">\u0921\u093f\u091d\u0947\u0932 \u0932\u093f\u091f\u0930 \u0905\u0902\u0915\u0940</td>\n\t\t\t<td class=\"fill\">{{ \"%g\"|format(qty) }} \u0932\u093f.</td>\n\t\t\t<td class=\"end\">\u0926\u0947\u0923\u0947</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td class=\"lbl\">\u0921\u093f\u091d\u0947\u0932 \u0905\u0915\u094d\u0937\u0930\u0940</td>\n\t\t\t<td class=\"fill\" colspan=\"2\">{{ marathi_number_words(qty, \"\u0932\u093f\u091f\u0930\") }}</td>\n\t\t</tr>\n\t\t{%- if doc.note %}\n\t\t<tr>\n\t\t\t<td class=\"lbl\">\u091f\u0940\u092a</td>\n\t\t\t<td class=\"fill\" colspan=\"2\" style=\"font-weight:normal\">{{ doc.note }}</td>\n\t\t</tr>\n\t\t{%- endif %}\n\t</table>\n\n\t<table class=\"sign\">\n\t\t<tr>\n\t\t\t<td><span class=\"cap\">\u0921\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u0930\u091a\u0940 \u0938\u0939\u0940</span></td>\n\t\t\t<td><span class=\"cap\">\u0915\u094d\u0932\u093e\u0930\u094d\u0915\u091a\u0940 \u0938\u0939\u0940</span></td>\n\t\t</tr>\n\t</table>\n</div>\n",
