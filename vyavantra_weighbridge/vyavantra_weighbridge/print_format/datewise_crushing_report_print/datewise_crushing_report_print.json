 "font_size": 10,
 "html": "<style>\n.wbr { font-family: \"Noto Sans Devanagari\", \"Lohit Devanagari\", \"DejaVu Sans\", Arial, sans-serif; font-size: 11px; color: #000; }\n.wbr .co { text-align: center; font-weight: bold; font-size: 14px; text-transform: uppercase; }\n.wbr .ad { text-align: center; font-size: 11px; margin-top: 2px; }\n.wbr .ti { text-align: center; font-weight: bold; font-size: 12px; margin: 8px 0 2px 0; text-transform: uppercase; }\n.wbr table { width: 100%; margin-left: auto; margin-right: auto; border-collapse: collapse; page-break-inside: auto; }\n.wbr thead { display: table-header-group; }\n.wbr tr { page-break-inside: avoid; }\n.wbr th, .wbr td { border: 1px solid #000; padding: 3px 5px; vertical-align: middle; }\n.wbr th { text-align: center; font-weight: bold; background: #fff; }\n.wbr td.n { text-align: right; white-space: nowrap; }\n.wbr td.c { text-align: center; }\n.wbr tr.tot td { font-weight: bold; }\n.wbr tr.dh td { border-left: none; border-right: none; font-weight: bold; text-align: center; }\n.wbr tr.st td { font-weight: bold; border-left: none; border-right: none; }\n</style>\n<div id=\"footer-html\" class=\"visible-pdf\"><p class=\"text-center small page-number visible-pdf\" style=\"text-align: center; width: 100%;\">Page <span class=\"page\"></span> of <span class=\"topage\"></span></p></div>\n{% var h = (report && report.wb_heading) || {}; var tz = function(v) { return (parseFloat(v) || 0).toFixed(3); }; var ds = function(s) { if (!s) { return \"\"; } var p = String(s).split(\"-\"); return p.length === 3 ? p[2] + \"/\" + p[1] + \"/\" + p[0] : s; }; var today = ds(frappe.datetime.get_today()); %}\n<div class=\"wbr\">\n<div class=\"co\">{{ h.company || \"\" }}</div>\n<div class=\"ad\">{{ h.address || \"\" }}</div>\n<div class=\"ad\">{% if (h.phone) { %}PH.NO.: {{ h.phone }}{% } %}</div>\n\n<div class=\"ti\" style=\"margin-bottom: 0;\">CANE CRUSHING REPORT</div>\n<div class=\"ad\" style=\"margin-bottom: 8px;\">{{ ds(filters.from_date) }} &nbsp;&nbsp;&nbsp; {{ ds(filters.to_date) }}</div>\n<table style=\"font-size: 10px;\">\n<thead><tr><th>Sr No</th><th>Farmer Name</th><th>Village</th><th>Cane Variety</th><th>Veh No</th><th>Slip No</th><th>Tod Cont Name</th><th>Transporter Name</th><th>Cn Wt</th></tr></thead>\n<tbody>\n{% for (var r = 0; r < data.length; r++) { var row = data[r]; %}\n{% if (row.row_type === \"date\") { %}\n<tr class=\"dh\"><td colspan=\"9\" style=\"text-align: left; padding-top: 8px;\">{{ row.farmer_name }}</td></tr>\n{% } else if (row.row_type === \"subtotal\") { %}\n<tr class=\"st\"><td colspan=\"8\" style=\"text-align: right;\">{{ row.farmer_name }}</td><td class=\"n\">{{ tz(row.cane_weight) }}</td></tr>\n{% } else if (row.row_type === \"total\") { %}\n<tr class=\"tot\"><td colspan=\"8\" style=\"text-align: right;\">{{ row.farmer_name }}</td><td class=\"n\">{{ tz(row.cane_weight) }}</td></tr>\n{% } else { %}\n<tr><td class=\"c\">{{ row.sr_no }}</td><td>{{ row.farmer_name || \"\" }}</td><td>{{ row.village || \"\" }}</td><td class=\"c\">{{ row.variety || \"\" }}</td><td>{{ row.vehicle || \"\" }}</td><td>{{ row.slip_no }}</td><td>{{ row.todani_contractor || \"\" }}</td><td>{{ row.transporter || \"\" }}</td><td class=\"n\">{{ tz(row.cane_weight) }}</td></tr>\n{% } %}\n{% } %}\n</tbody>\n</table>\n</div>\n",
 "idx": 0,
