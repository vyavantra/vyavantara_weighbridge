 "font_size": 10,
 "html": "<style>\n.wbr { font-family: \"Noto Sans Devanagari\", \"Lohit Devanagari\", \"DejaVu Sans\", Arial, sans-serif; font-size: 11px; color: #000; }\n.wbr .co { text-align: center; font-weight: bold; font-size: 14px; text-transform: uppercase; }\n.wbr .ad { text-align: center; font-size: 11px; margin-top: 2px; }\n.wbr .ti { text-align: center; font-weight: bold; font-size: 12px; margin: 8px 0 2px 0; text-transform: uppercase; }\n.wbr table { width: 100%; margin-left: auto; margin-right: auto; border-collapse: collapse; page-break-inside: auto; }\n.wbr thead { display: table-header-group; }\n.wbr tr { page-break-inside: avoid; }\n.wbr th, .wbr td { border: 1px solid #000; padding: 3px 5px; vertical-align: middle; }\n.wbr th { text-align: center; font-weight: bold; background: #fff; }\n.wbr td.n { text-align: right; white-space: nowrap; }\n.wbr td.c { text-align: center; }\n.wbr tr.tot td { font-weight: bold; }\n.wbr tr.dh td { border-left: none; border-right: none; font-weight: bold; text-align: center; }\n.wbr tr.st td { font-weight: bold; border-left: none; border-right: none; }\n</style>\n<div id=\"footer-html\" class=\"visible-pdf\"><p class=\"text-center small page-number visible-pdf\" style=\"text-align: center; width: 100%;\">Page <span class=\"page\"></span> of <span class=\"topage\"></span></p></div>\n{% var h = (report && report.wb_heading) || {}; var tz = function(v) { return (parseFloat(v) || 0).toFixed(3); }; var ds = function(s) { if (!s) { return \"\"; } var p = String(s).split(\"-\"); return p.length === 3 ? p[2] + \"/\" + p[1] + \"/\" + p[0] : s; }; var today = ds(frappe.datetime.get_today()); %}\n<div class=\"wbr\">\n<div class=\"co\">{{ h.company || \"\" }}</div>\n<div class=\"ad\">{{ h.address || \"\" }}</div>\n<div class=\"ad\">{% if (h.phone) { %}PH.NO.: {{ h.phone }}{% } %}</div>\n\n<div style=\"height: 220px;\"></div><div class=\"ad\" style=\"margin-top: 10px;\">REPORT BETWEEN {{ ds(filters.from_date) }} AND {{ ds(filters.to_date) }} &nbsp;&nbsp; Print Date &nbsp; {{ today }}</div>\n<div class=\"ti\">DATEWISE SUMMARY</div>\n<table style=\"width: 60%; margin: 14px auto 0 auto;\">\n<thead><tr><th style=\"text-align: left;\">Delivery Type</th><th>Nos</th><th>Tonnage</th></tr></thead>\n<tbody>\n{% for (var r = 0; r < data.length; r++) { var row = data[r]; %}\n<tr class=\"{%= r === data.length - 1 ? \"tot\" : \"\" %}\"><td>{{ row.delivery_type }}</td><td class=\"n\">{{ row.nos || 0 }}</td><td class=\"n\">{{ tz(row.tonnage) }}</td></tr>\n{% } %}\n</tbody>\n</table>\n</div>\n",
 "idx": 0,
