 "font_size": 14,
 "html": "<style>\n.wbp { font-family: \"SlipDeva\", \"Noto Sans Devanagari\", sans-serif; font-size: 13px; color: #111; }\n.wbp table { width: 100%; border-collapse: collapse; }\n.wbp td, .wbp th { padding: 4px 6px; border: 1px solid #555; }\n.wbp h3 { margin: 0 0 6px 0; text-align: center; }\n.wbp .head { text-align: center; border-bottom: 2px solid #0b2a5b; padding-bottom: 6px; margin-bottom: 8px; }\n.wbp .r { text-align: right; } .wbp .b { font-weight: bold; }\n.wbp .sign td { border: none; padding-top: 34px; text-align: center; }\n</style>\n<div class=\"wbp\">\n <div class=\"head\"><h3>{{ _(\"Cheque Issue Voucher\") }}</h3></div>\n <table>\n  <tr><td class=\"b\">{{ _(\"Voucher No.\") }}</td><td>{{ doc.name }}</td><td class=\"b\">{{ _(\"Date\") }}</td><td>{{ doc.get_formatted(\"payment_date\") }}</td></tr>\n  <tr><td class=\"b\">{{ _(\"Pay To\") }}</td><td colspan=\"3\">{{ doc.party_name }}</td></tr>\n  <tr><td class=\"b\">{{ _(\"Against\") }}</td><td colspan=\"3\">{{ doc.bill_doctype }} {{ doc.bill }}</td></tr>\n  <tr><td class=\"b\">{{ _(\"Mode\") }}</td><td>{{ doc.mode }}</td><td class=\"b\">{{ _(\"Bank\") }}</td><td>{{ doc.bank or \"\" }}</td></tr>\n  <tr><td class=\"b\">{{ _(\"Cheque No.\") }}</td><td>{{ doc.cheque_no or \"\" }}</td><td class=\"b\">{{ _(\"Cheque Date\") }}</td><td>{{ doc.get_formatted(\"cheque_date\") if doc.cheque_date else \"\" }}</td></tr>\n  <tr><td class=\"b\">{{ _(\"Amount\") }}</td><td colspan=\"3\" class=\"b\">{{ doc.get_formatted(\"amount\") }}<br><span style=\"font-weight:normal\">{{ frappe.utils.money_in_words(doc.amount) }}</span></td></tr>\n  <tr><td class=\"b\">{{ _(\"Approval\") }}</td><td>{{ doc.approval_status }} {% if doc.approved_by %}({{ doc.approved_by }}){% endif %}</td><td class=\"b\">{{ _(\"Reference\") }}</td><td>{{ doc.reference_no or \"\" }}</td></tr>\n </table>\n <table class=\"sign\"><tr><td>{{ _(\"Prepared By\") }}</td><td>{{ _(\"Approved By\") }}</td><td>{{ _(\"Received By\") }}</td></tr></table>\n</div>",
